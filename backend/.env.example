# Gemini API Key (Required)
# Get your key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Allowed Frontend Origins (Optional - comma separated, or * for all)
# Examples:
# FRONTEND_ORIGIN=*
# FRONTEND_ORIGIN=http://localhost:5173,https://your-frontend.onrender.com,https://your-frontend.vercel.app
FRONTEND_ORIGIN=*

# Gemini Model Name (Optional, defaults to gemini-3.5-flash-lite)
GEMINI_MODEL=gemini-3.5-flash-lite

# Port (Render sets this automatically; defaults to 8000 locally)
PORT=8000
